[{"id":"rec:AR","gene":"AR","names":{"es":"Receptor de andrógenos","en":"Androgen receptor","corto":"AR"},"class":"nuclear","isoforms":["AR-A","AR-B"],"mechanism":"Receptor nuclear de la familia de esteroides. Sin ligando permanece en el citoplasma unido a chaperonas; al unir testosterona o dihidrotestosterona se dimeriza, entra al núcleo y se une a elementos de respuesta a andrógenos. La dihidrotestosterona se disocia más despacio, y de ahi su mayor potencia.","ligands":[{"mol":"mol:dht","kind":"agonista"},{"mol":"mol:testosterona","kind":"agonista"},{"mol":"mol:11ceto_testosterona","kind":"agonista"},{"mol":"mol:androstenediona","kind":"agonista_parcial"},{"mol":"drug:bicalutamida","kind":"antagonista"},{"mol":"drug:enzalutamida","kind":"antagonista"},{"mol":"drug:flutamida","kind":"antagonista"},{"mol":"drug:apalutamida","kind":"antagonista"},{"mol":"drug:darolutamida","kind":"antagonista"},{"mol":"drug:ciproterona_ac","kind":"antagonista"},{"mol":"drug:espironolactona","kind":"antagonista"},{"mol":"drug:drospirenona","kind":"antagonista"},{"mol":"drug:nandrolona","kind":"agonista"},{"mol":"drug:oxandrolona","kind":"agonista"},{"mol":"drug:estanozolol","kind":"agonista"},{"mol":"drug:mesterolona","kind":"agonista"},{"mol":"drug:danazol","kind":"agonista_parcial"},{"mol":"drug:levonorgestrel","kind":"agonista_parcial"}],"source":["read:miller2011","read:mooradian1987"]},{"id":"rec:ERa","gene":"ESR1","names":{"es":"Receptor de estrógenos alfa","en":"Estrogen receptor alpha","corto":"ERα"},"class":"nuclear","isoforms":null,"mechanism":"Media la mayor parte de los efectos proliferativos del estradiol en mama, útero, hueso e hígado. Los moduladores selectivos se comportan como agonistas en unos tejidos y antagonistas en otros según los coactivadores presentes.","ligands":[{"mol":"mol:estradiol","kind":"agonista"},{"mol":"mol:estrona","kind":"agonista_parcial"},{"mol":"mol:estriol","kind":"agonista_parcial"},{"mol":"mol:estetrol","kind":"agonista_parcial"},{"mol":"drug:etinilestradiol","kind":"agonista"},{"mol":"drug:tamoxifeno","kind":"modulador"},{"mol":"drug:raloxifeno","kind":"modulador"},{"mol":"drug:clomifeno","kind":"modulador"},{"mol":"drug:bazedoxifeno","kind":"modulador"},{"mol":"drug:ospemifeno","kind":"modulador"},{"mol":"drug:fulvestrant","kind":"antagonista"},{"mol":"drug:tibolona","kind":"agonista_parcial"}],"source":["read:miller2011","read:speroff2020"]},{"id":"rec:ERb","gene":"ESR2","names":{"es":"Receptor de estrógenos beta","en":"Estrogen receptor beta","corto":"ERβ"},"class":"nuclear","isoforms":null,"mechanism":"Distribucion distinta de la del receptor alfa, con papel destacado en ovario, próstata, sistema nervioso central, endotelio y colon. A menudo se opone a la señal proliferativa del receptor alfa.","ligands":[{"mol":"mol:estradiol","kind":"agonista"},{"mol":"mol:estriol","kind":"agonista_parcial"},{"mol":"mol:androstanodiol","kind":"agonista_parcial"},{"mol":"drug:raloxifeno","kind":"modulador"}],"source":["read:miller2011"]},{"id":"rec:PR","gene":"PGR","names":{"es":"Receptor de progesterona","en":"Progesterone receptor","corto":"PR"},"class":"nuclear","isoforms":["PR-A","PR-B"],"mechanism":"Su expresión depende del estímulo estrogénico previo: sin estrógeno no hay receptor, y por eso la progesterona solo actua sobre un tejido ya preparado. PR-B activa la transcripción y PR-A la reprime.","ligands":[{"mol":"mol:progesterona","kind":"agonista"},{"mol":"drug:levonorgestrel","kind":"agonista"},{"mol":"drug:noretisterona","kind":"agonista"},{"mol":"drug:dienogest","kind":"agonista"},{"mol":"drug:drospirenona","kind":"agonista"},{"mol":"drug:mpa","kind":"agonista"},{"mol":"drug:etonogestrel","kind":"agonista"},{"mol":"drug:gestodeno","kind":"agonista"},{"mol":"drug:nomegestrol_ac","kind":"agonista"},{"mol":"drug:clormadinona_ac","kind":"agonista"},{"mol":"drug:ciproterona_ac","kind":"agonista"},{"mol":"drug:didrogesterona","kind":"agonista"},{"mol":"drug:mifepristona","kind":"antagonista"},{"mol":"drug:ulipristal_ac","kind":"modulador"}],"source":["read:speroff2020"]},{"id":"rec:GR","gene":"NR3C1","names":{"es":"Receptor de glucocorticoides","en":"Glucocorticoid receptor","corto":"GR"},"class":"nuclear","isoforms":null,"mechanism":"Ubicuo. Media la acción metabólica y antiinflamatoria del cortisol y explica los efectos adversos de los progestágenos con actividad glucocorticoide.","ligands":[{"mol":"mol:cortisol","kind":"agonista"},{"mol":"drug:dexametasona","kind":"agonista"},{"mol":"drug:prednisolona","kind":"agonista"},{"mol":"drug:mpa","kind":"agonista_parcial"},{"mol":"drug:mifepristona","kind":"antagonista"}],"source":["read:miller2011"]},{"id":"rec:MR","gene":"NR3C2","names":{"es":"Receptor de mineralocorticoides","en":"Mineralocorticoid receptor","corto":"MR"},"class":"nuclear","isoforms":null,"mechanism":"Une aldosterona y cortisol con afinidad parecida. La selectividad la impone la 11β-HSD2 del tubulo renal, que inactiva el cortisol antes de que llegue al receptor.","ligands":[{"mol":"mol:aldosterona","kind":"agonista"},{"mol":"mol:cortisol","kind":"agonista"},{"mol":"mol:doc","kind":"agonista"},{"mol":"drug:espironolactona","kind":"antagonista"},{"mol":"drug:drospirenona","kind":"antagonista"}],"source":["read:miller2011"]},{"id":"rec:GPER1","gene":"GPER1","names":{"es":"Receptor de estrógenos acoplado a proteína G","en":"G protein-coupled estrogen receptor","corto":"GPER1"},"class":"membrana","isoforms":null,"mechanism":"Receptor de membrana que explica efectos rápidos del estradiol, en segundos o minutos, incompatibles con la vía genomica clásica.","ligands":[{"mol":"mol:estradiol","kind":"agonista"},{"mol":"drug:tamoxifeno","kind":"agonista_parcial"}],"source":["read:miller2011"]}]