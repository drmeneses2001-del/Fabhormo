l":0.5},{"enzyme":"enz:CYP21A2","level":1},{"enzyme":"enz:CYP11B1","level":1},{"enzyme":"enz:CYP11B2","level":0},{"enzyme":"enz:POR","level":1}],"produces":["mol:cortisol"],"regulators":["ACTH"],"description":"Expresa CYP17A1 con actividad hidroxilasa alta y liasa baja: hidroxila en 17 pero no corta la cadena lateral, de modo que la vía termina en cortisol.","source":["read:miller2011"]},{"id":"tis:reticular","names":{"es":"Zona reticular","corto":"Zona reticular"},"organ":"org:suprarrenal","cell":"Célula de la zona reticular","zone":"reticularis","expression":[{"enzyme":"enz:StAR","level":1},{"enzyme":"enz:CYP11A1","level":1},{"enzyme":"enz:CYP17A1","level":1},{"enzyme":"enz:CYB5A","level":1},{"enzyme":"enz:SULT2A1","level":1},{"enzyme":"enz:HSD3B2","level":0.5},{"enzyme":"enz:CYP11B1","level":0.5},{"enzyme":"enz:POR","level":1}],"produces":["mol:dhea","mol:dhea_s","mol:11oh_androstenediona"],"regulators":["ACTH"],"description":"Citocromo b5 alto y 3β-HSD2 baja: la combinación favorece la actividad liasa y desvía el flujo hacia DHEA y su sulfato. Es el sustrato bioquímico de la adrenarquia.","source":["read:miller2011"]},{"id":"tis:sincitiotrofoblasto","names":{"es":"Sincitiotrofoblasto","corto":"Sincitiotrofoblasto"},"organ":"org:placenta","cell":"Sincitiotrofoblasto","zone":null,"expression":[{"enzyme":"enz:CYP11A1","level":1},{"enzyme":"enz:HSD3B1","level":1},{"enzyme":"enz:CYP19A1","level":1},{"enzyme":"enz:HSD17B1","level":1},{"enzyme":"enz:STS","level":1},{"enzyme":"enz:CYP17A1","level":0},{"enzyme":"enz:StAR","level":0.5}],"produces":["mol:progesterona","mol:estriol","mol:estradiol","mol:estrona"],"regulators":["hCG"],"description":"Tampoco expresa CYP17A1: no puede fabricar andrógenos y depende de los precursores sulfatados que le llegan del feto. Ese reparto de tareas es la unidad fetoplacentaria.","source":["read:miller2011"]},{"id":"tis:adiposo","names":{"es":"Tejido adiposo","corto":"Tejido adiposo"},"organ":"org:adiposo","cell":"Célula estromal del adiposo","zone":null,"expression":[{"enzyme":"enz:CYP19A1","level":1},{"enzyme":"enz:AKR1C3","level":1},{"enzyme":"enz:HSD17B2","level":0.5},{"enzyme":"enz:STS","level":0.5},{"enzyme":"enz:SRD5A1","level":0.5}],"produces":["mol:estrona","mol:estradiol","mol:testosterona"],"regulators":[],"description":"Principal fuente de estrógenos tras la menopausia y en el varon: aromatiza los andrógenos circulantes en un proceso que aumenta con la masa grasa.","source":["read:miller2011"]},{"id":"tis:piel_genital","names":{"es":"Piel genital","corto":"Piel genital"},"organ":"org:genitales_externos","cell":"Fibroblasto de la piel genital","zone":null,"expression":[{"enzyme":"enz:SRD5A2","level":1},{"enzyme":"enz:AKR1C3","level":0.5},{"enzyme":"enz:SRD5A1","level":0.5},{"enzyme":"enz:HSD17B6","level":0.5}],"produces":["mol:dht"],"regulators":[],"description":"La 5α-reductasa tipo 2 de este tejido es la que viriliza los genitales externos durante la vida fetal.","source":["read:miller2011"]},{"id":"tis:foliculo_piloso","names":{"es":"Folículo piloso y glándula sebácea","corto":"Folículo piloso y glándula sebácea"},"organ":"org:piel","cell":"Unidad pilosebacea","zone":null,"expression":[{"enzyme":"enz:SRD5A1","level":1},{"enzyme":"enz:SRD5A2","level":0.5},{"enzyme":"enz:AKR1C3","level":1},{"enzyme":"enz:CYP19A1","level":0.5}],"produces":["mol:dht"],"regulators":[],"description":"Explica el acné y el hirsutismo con andrógenos circulantes normales: la conversión local decide el efecto.","source":["read:miller2011"]},{"id":"tis:prostata_estroma","names":{"es":"Próstata","corto":"Próstata"},"organ":"org:prostata","cell":"Célula estromal y epitelial prostática","zone":null,"expression":[{"enzyme":"enz:SRD5A2","level":1},{"enzyme":"enz:SRD5A1","level":0.5},{"enzyme":"enz:AKR1C3","level":1},{"enzyme":"enz:HSD17B6","level":0.5}],"produces":["mol:dht"],"regulators":[],"description":"Concentra DHT muy por encima de la testosterona plasmática: es la diana clásica de los inhibidores de 5α-reductasa.","source":["read:miller2011"]},{"id":"tis:mama_estroma","names":{"es":"Estroma mamario","corto":"Estroma mamario"},"organ":"org:mama","cell":"Fibroblasto y adipocito mamario","zone":null,"expression":[{"enzyme":"enz:CYP19A1","level":1},{"enzyme":"enz:STS","level":1},{"enzyme":"enz:HSD17B1","level":1},{"enzyme":"enz:SULT1E1","level":0.5}],"produces":["mol:estradiol","mol:estrona"],"regulators":[],"description":"La suma de aromatasa y sulfatasa mantiene concentraciones intratumorales de estradiol muy superiores a las plasmáticas en la posmenopausia.","source":["read:miller2011"]},{"id":"tis:hepatocito","names":{"es":"Hepatocito","corto":"Hepatocito"},"organ":"org:higado","cell":"Hepatocito","zone":null,"expression":[{"enzyme":"enz:SRD5A1","level":1},{"enzyme":"enz:HSD11B1","level":1},{"enzyme":"enz:SULT2A1","level":1},{"enzyme":"enz:SULT1E1","level":1},{"enzyme":"enz:CYP3A4","level":1},{"enzyme":"enz:CYP3A7","level":0.5},{"enzyme":"enz:HSD11B2","level":0.5}],"produces":["mol:cortisol","mol:estrona_sulfato"],"regulators":[],"description":"Inactiva y conjuga: define la vida media de las hormonas y de casi todos los fármacos esteroideos, y sintetiza la SHBG que las transporta.","source":["read:miller2011"]},{"id":"tis:cerebro_glia","names":{"es":"Sistema nervioso central","corto":"Sistema nervioso central"},"organ":"org:cerebro","cell":"Neurona y glia","zone":null,"expression":[{"enzyme":"enz:CYP19A1","level":1},{"enzyme":"enz:SRD5A1","level":1},{"enzyme":"enz:AKR1C2","level":1},{"enzyme":"enz:CYP11A1","level":0.5},{"enzyme":"enz:StAR","level":0.5}],"produces":["mol:alopregnanolona","mol:estradiol"],"regulators":[],"description":"Fabrica neuroesteroides in situ. La alopregnanolona modula el receptor GABA-A y la aromatasa local participa en la diferenciación sexual del cerebro.","source":["read:miller2011"]},{"id":"tis:hueso_osteoblasto","names":{"es":"Hueso","corto":"Hueso"},"organ":"org:hueso","cell":"Osteoblasto","zone":null,"expression":[{"enzyme":"enz:CYP19A1","level":0.5},{"enzyme":"enz:AKR1C3","level":0.5},{"enzyme":"enz:SRD5A1","level":0.5}],"produces":["mol:estradiol"],"regulators":[],"description":"El estradiol local, incluido el aromatizado a partir de andrógenos, es lo que cierra el cartílago de crecimiento en ambos sexos.","source":["read:miller2011"]}]