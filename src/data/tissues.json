[{"id":"tis:leydig","names":{"es":"Célula de Leydig","corto":"Célula de Leydig"},"organ":"org:testiculo","cell":"Célula de Leydig","zone":null,"expression":[{"enzyme":"enz:StAR","level":1},{"enzyme":"enz:CYP11A1","level":1},{"enzyme":"enz:HSD3B2","level":1},{"enzyme":"enz:CYP17A1","level":1},{"enzyme":"enz:CYB5A","level":1},{"enzyme":"enz:POR","level":1},{"enzyme":"enz:HSD17B3","level":1},{"enzyme":"enz:AKR1C3","level":0.5},{"enzyme":"enz:SRD5A1","level":0.5},{"enzyme":"enz:CYP19A1","level":0.5},{"enzyme":"enz:CYP21A2","level":0},{"enzyme":"enz:CYP11B1","level":0}],"produces":["mol:testosterona","mol:androstenediona","mol:dhea"],"regulators":["LH","hCG"],"description":"Única fuente relevante de testosterona en el varon. Responde a LH con un aumento agudo del transporte de colesterol por StAR.","source":["read:miller2011"]},{"id":"tis:teca","names":{"es":"Célula de la teca","corto":"Célula de la teca"},"organ":"org:ovario","cell":"Célula de la teca interna","zone":null,"expression":[{"enzyme":"enz:StAR","level":1},{"enzyme":"enz:CYP11A1","level":1},{"enzyme":"enz:HSD3B2","level":1},{"enzyme":"enz:CYP17A1","level":1},{"enzyme":"enz:CYB5A","level":0.5},{"enzyme":"enz:POR","level":1},{"enzyme":"enz:HSD17B3","level":0.5},{"enzyme":"enz:CYP19A1","level":0},{"enzyme":"enz:CYP21A2","level":0},{"enzyme":"enz:CYP11B1","level":0}],"produces":["mol:androstenediona","mol:testosterona"],"regulators":["LH"],"description":"Mitad androgénica del folículo: fabrica el precursor que la granulosa aromatiza. No expresa aromatasa, así que por si sola no produce estrógeno.","source":["read:miller2011"]},{"id":"tis:granulosa","names":{"es":"Célula de la granulosa","corto":"Célula de la granulosa"},"organ":"org:ovario","cell":"Célula de la granulosa","zone":null,"expression":[{"enzyme":"enz:CYP19A1","level":1},{"enzyme":"enz:HSD17B1","level":1},{"enzyme":"enz:CYP17A1","level":0},{"enzyme":"enz:HSD3B2","level":0.5},{"enzyme":"enz:StAR","level":0.5},{"enzyme":"enz:CYP11A1","level":0.5},{"enzym