{"id":"cycle:ovarico","names":{"es":"Ciclo ovarico y endometrial","en":"Ovarian and endometrial cycle"},"days":28,"ovulation":14,"note":"Perfiles normalizados de 0 a 1: representan la forma de cada curva y su relacion temporal, no concentraciones absolutas. Las cifras de referencia estan en el modulo de laboratorio.","phases":[{"id":"menstrual","label":"Menstrual","from_":1,"to":5,"text":"Caida de estradiol y progesterona tras la luteolisis: se descama el endometrio. La FSH empieza a subir y recluta la nueva cohorte folicular."},{"id":"folicular","label":"Folicular","from_":6,"to":13,"text":"El foliculo dominante fabrica estradiol en cantidad creciente. La teca aporta androgenos y la granulosa los aromatiza. El estradiol prolifera el endometrio y frena la FSH, lo que condena al resto de la cohorte."},{"id":"ovulacion","label":"Ovulacion","from_":14,"to":15,"text":"El estradiol sostenido por encima de un umbral invierte la retroalimentacion: la hipofisis responde con el pico de LH y el foliculo se rompe."},{"id":"lutea","label":"Lutea","from_":16,"to":28,"text":"El cuerpo luteo produce progesterona, que transforma el endometrio en secretor y enlentece los pulsos de GnRH. Sin gestacion, la luteolisis retira el soporte y el ciclo vuelve a empezar."}],"series":[{"id":"estradiol","label":"Estradiol","color":"fam-estrogeno","mol":"mol:estradiol"},{"id":"progesterona","label":"Progesterona","color":"fam-gestageno","mol":"mol:progesterona"},{"id":"lh","label":"LH","color":"accent","mol":null},{"id":"fsh","label":"FSH","color":"enz-sulf","mol":null},{"id":"inhibina_b","label":"Inhibina B","color":"ink-3","mol":null},{"id":"inhibina_a","label":"Inhibina A","color":"ring-side","mol":null},{"id":"endometrio","label":"Grosor endometrial","color":"fam-farmaco","mol":null},{"id":"foliculo","label":"Foliculo y cuerpo luteo","color":"enz-red","mol":null}],"tissuesByDay":[{"from_":1,"to":5,"tissues":[]},{"from_":6,"to":13,"tissues":["tis:teca","tis:granulosa"]},{"from_":14,"to":15,"tissues":["tis:teca","tis:granulosa"]},{"from_":16,"to":28,"tissues":["tis:cuerpo_luteo"]}],"source":["read:speroff2020"],"curves":{"estradiol":[0.08,0.08,0.08,0.08,0.082,0.088,0.111,0.175,0.315,0.544,0.813,1,1,0.878,0.655,0.477,0.389,0.373,0.391,0.412,0.42,0.411,0.384,0.343,0.296,0.247,0.203,0.165],"lh":[0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.103,0.29,0.889,0.889,0.29,0.103,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09,0.09],"fsh":[0.414,0.455,0.455,0.414,0.349,0.281,0.227,0.192,0.174,0.171,0.209,0.353,0.545,0.545,0.352,0.208,0.166,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16],"progesterona":[0.03,0.03,0.03,0.03,0.03,0.03,0.03,0.031,0.032,0.036,0.044,0.059,0.089,0.138,0.216,0.326,0.465,0.622,0.776,0.901,0.971,0.971,0.901,0.776,0.622,0.465,0.326,0.216],"inhibina_b":[0.301,0.377,0.47,0.575,0.678,0.768,0.828,0.85,0.828,0.768,0.678,0.575,0.47,0.377,0.301,0.245,0.206,0.181,0.166,0.158,0.154,0.152,0.151,0.15,0.15,0.15,0.15,0.15],"inhibina_a":[0.05,0.05,0.05,0.05,0.05,0.05,0.051,0.052,0.054,0.059,0.069,0.087,0.118,0.165,0.234,0.326,0.439,0.566,0.692,0.8,0.874,0.9,0.874,0.8,0.692,0.566,0.439,0.326],"endometrio":[0.12,0.12,0.12,0.12,0.181,0.241,0.302,0.364,0.426,0.49,0.556,0.624,0.696,0.77,0.848,0.928,0.949,0.971,0.99,1,1,1,1,1,0.99,0.971,0.949,0.928],"foliculo":[0.15,0.15,0.15,0.223,0.295,0.368,0.441,0.514,0.586,0.659,0.732,0.805,0.877,0.95,0.376,0.447,0.521,0.59,0.648,0.687,0.7,0.687,0.648,0.59,0.521,0.447,0.376,0.314]}}